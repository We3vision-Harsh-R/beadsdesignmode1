PORT=5000
NODE_ENV=development

# Supabase (Project Settings -> API Keys). The secret key must stay on the server only.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# Frontend URL (for CORS). Comma separate multiple URLs.
CLIENT_URL=http://localhost:5173

# First admin account (run: npm run create-admin). Use your real email.
ADMIN_NAME=Store Admin
ADMIN_EMAIL=you@yourdomain.com
ADMIN_PASSWORD=choose-a-strong-password

# Manual UPI payment (customer pays to this UPI ID, admin confirms the order)
UPI_ID=
UPI_NAME=

# Shown on the website for support
SUPPORT_EMAIL=
SUPPORT_PHONE=
# WhatsApp number with country code, digits only, e.g. 919876543210
WHATSAPP_NUMBER=

# Razorpay online payments (optional). Set UPI_ID and/or these keys - at least one is needed to sell.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret you choose in Razorpay -> Webhooks (URL: https://yourdomain.com/api/payments/razorpay/webhook)
RAZORPAY_WEBHOOK_SECRET=
